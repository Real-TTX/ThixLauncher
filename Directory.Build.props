<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Matthias Schmoldt</Company>
    <Product>ThixLauncher</Product>
    <Authors>Matthias Schmoldt</Authors>
    <Copyright>© Matthias Schmoldt</Copyright>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Versioning (single source of truth: Major/Minor below). CI sets Channel / BuildNumber / BuildDate:
      release : <major>.<minor>.<build>-<date>   e.g. 0.1.42-20261116   (branch main)
      nightly : nightly-<build>-<date>          e.g. nightly-43-20261116 (branch dev)
      local   : local-<date>                    e.g. local-20261116      (every local build)
    The build number is the GitHub run number and increases with every build; the update check compares it.
  -->
  <PropertyGroup>
    <ThixLauncherMajor>0</ThixLauncherMajor>
    <ThixLauncherMinor>1</ThixLauncherMinor>

    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Channel Condition="'$(Channel)' == ''">local</Channel>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</BuildDate>

    <Version>$(ThixLauncherMajor).$(ThixLauncherMinor).$(BuildNumber)</Version>
    <AssemblyVersion>$(ThixLauncherMajor).$(ThixLauncherMinor).0.0</AssemblyVersion>
    <FileVersion>$(ThixLauncherMajor).$(ThixLauncherMinor).$(BuildNumber).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Channel)' == 'release'">
    <InformationalVersion>$(ThixLauncherMajor).$(ThixLauncherMinor).$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'nightly'">
    <InformationalVersion>nightly-$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'local'">
    <InformationalVersion>local-$(BuildDate)</InformationalVersion>
  </PropertyGroup>

  <!-- The running program needs channel and build number (update check, about page). -->
  <ItemGroup>
    <AssemblyMetadata Include="ThixLauncherChannel" Value="$(Channel)" />
    <AssemblyMetadata Include="ThixLauncherBuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="ThixLauncherRepository" Value="Real-TTX/ThixLauncher" />
  </ItemGroup>

</Project>
