<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixLauncher.Controls"
             x:Class="ThixLauncher.Pages.StorePage">
  <!--
    The store: every Thix app. The title with the search beside it, then one app big – its picture from GitHub, logo, name,
    what it does, its state and the main action, "Mehr erfahren"; ‹ › go through the apps – and under it every app as a tile
    with its cover (a click opens the app's page, the button on the tile installs, updates or opens it). A search hides the
    big app and shows the tiles that match.
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://ThixLauncher/Pages/TileStyles.axaml" />
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="{DynamicResource Mat.FontSizeXs}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Mat.AccentText}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Mat.Surface}">
    <Grid RowDefinitions="Auto,*">
      <Grid Margin="28,20,28,0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="TitleText" Text="Store" Theme="{StaticResource MatText.PageTitle}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="SearchBox" Theme="{StaticResource MatSearchBox}" Width="260" VerticalAlignment="Center"
                 Watermark="Im Store suchen" AutomationProperties.Name="Im Store suchen" ToolTip.Tip="Im Store suchen" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="SubtitleText" Theme="{StaticResource MatText.Muted}" Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </Grid>

      <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,24" Spacing="18">
          <controls:InfoBar x:Name="PageMessage" />

          <!-- One app big: the picture at the left, what it is and the action at the right -->
          <Border x:Name="Hero" Theme="{StaticResource MatCard}" Padding="0" ClipToBounds="True" Height="318" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- The picture takes what the text leaves (a screenshot's shape at the usual widths), the text a fixed column -->
            <Grid ColumnDefinitions="*,384">
              <Border Background="{DynamicResource Mat.Surface2}" Cursor="Hand" x:Name="HeroPictureFrame">
                <controls:AppPicture x:Name="HeroPicture" DecodeWidth="1200" LogoSize="96" />
              </Border>
              <!-- Rows: what it is to the user with ‹ 1 / 8 ›, name, the text (takes the rest, cut), the state, the buttons -->
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24,18,22,18">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="HeroEyebrow" Classes="eyebrow" Text="EMPFOHLEN" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,-6,-6,-6">
                    <Button x:Name="PreviousButton" Theme="{StaticResource MatButton.Icon}" Click="OnPreviousClick"
                            AutomationProperties.Name="Vorherige App" ToolTip.Tip="Vorherige App">
                      <mat:MatIcon Icon="chevron-left" Size="16" />
                    </Button>
                    <TextBlock x:Name="HeroPosition" Theme="{StaticResource MatText.Muted}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center" />
                    <Button x:Name="NextButton" Theme="{StaticResource MatButton.Icon}" Click="OnNextClick"
                            AutomationProperties.Name="Nächste App" ToolTip.Tip="Nächste App">
                      <mat:MatIcon Icon="chevron-right" Size="16" />
                    </Button>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                  <controls:AppLogo x:Name="HeroLogo" Size="52" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroName" FontSize="{DynamicResource Mat.FontSize2xl}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeroTagline" Theme="{StaticResource MatText.Muted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="HeroDescription" TextWrapping="Wrap" TextTrimming="WordEllipsis" LineHeight="20"
                           Margin="0,12,0,0" ClipToBounds="True" />
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,10,0,14">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:StateBadge x:Name="HeroBadge" />
                    <TextBlock x:Name="HeroVersion" Theme="{StaticResource MatText.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ProgressBar x:Name="HeroProgress" Theme="{StaticResource MatProgress}" Maximum="1" IsVisible="False" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="HeroAction" Theme="{StaticResource MatButton.Primary}" Click="OnHeroActionClick">
                    <controls:IconLabel x:Name="HeroActionLabel" Icon="download" Text="Installieren" />
                  </Button>
                  <Button x:Name="HeroMore" Click="OnHeroMoreClick">
                    <controls:IconLabel Icon="info" Text="Mehr erfahren" />
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <StackPanel Spacing="2">
            <TextBlock x:Name="SectionTitle" Text="Alle Apps" FontSize="{DynamicResource Mat.FontSizeLg}" FontWeight="SemiBold" />
            <TextBlock x:Name="SectionText" Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox x:Name="AppList" Theme="{StaticResource MatList}" SelectionMode="Single"
                   AutomationProperties.Name="Alle Apps im Store">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <StackPanel x:Name="EmptyState" IsVisible="False" HorizontalAlignment="Center" Spacing="10" Margin="0,24,0,0">
            <mat:MatIcon Icon="search" Size="32" HorizontalAlignment="Center" Foreground="{DynamicResource Mat.TextFaint}" />
            <TextBlock x:Name="EmptyText" Theme="{StaticResource MatText.Muted}" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
