<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixLauncher.Controls"
             x:Class="ThixLauncher.Pages.SettingsPage">
  <!-- Settings in tabs: Allgemein | Apps | Cloud | Updates | Erweitert. A switch applies at once (like macOS). -->
  <Border Background="{DynamicResource Mat.Surface}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,28" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Einstellungen" Theme="{StaticResource MatText.PageTitle}" />
        <TextBlock x:Name="PolicyNote" Theme="{StaticResource MatText.Muted}" Margin="0,4,0,0" IsVisible="False" TextWrapping="Wrap"
                   Text="Von deiner Organisation festgelegt: was eine Richtlinie bestimmt, ist hier ausgeschaltet." />
        <controls:InfoBar x:Name="PageMessage" Margin="0,14,0,0" />

        <TabControl x:Name="Tabs" Margin="0,12,0,0">
          <!-- ===== General ===== -->
          <TabItem x:Name="GeneralTabItem" Header="Allgemein">
            <StackPanel>
              <mat:MatSettingRow Title="Bei der Anmeldung starten" Description="ThixLauncher startet unsichtbar im Infobereich / in der Menüleiste und hält die Apps aktuell.">
                <ToggleSwitch x:Name="AutostartSwitch" OnContent="" OffContent="" AutomationProperties.Name="Bei der Anmeldung starten" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Erscheinungsbild" BorderThickness="0">
                <ComboBox x:Name="ThemeChoice" MinWidth="170" AutomationProperties.Name="Erscheinungsbild">
                  <ComboBoxItem Content="Wie das System" />
                  <ComboBoxItem Content="Hell" />
                  <ComboBoxItem Content="Dunkel" />
                </ComboBox>
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="Theme" Margin="0" />
            </StackPanel>
          </TabItem>

          <!-- ===== Apps ===== -->
          <TabItem x:Name="AppsTabItem" Header="Apps">
            <StackPanel>
              <mat:MatSettingRow Title="Kanal" Description="Release: die geprüften Versionen (Branch main). Nightly: jeder neue Stand (Branch dev) – neuer, aber weniger getestet.">
                <ComboBox x:Name="ChannelChoice" MinWidth="170" AutomationProperties.Name="Kanal">
                  <ComboBoxItem Content="Release" />
                  <ComboBoxItem Content="Nightly" />
                </ComboBox>
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="AppChannel" Margin="0" />
              <mat:MatSettingRow Title="Apps automatisch aktualisieren"
                                 Description="Apps, die sich ohne Rückfrage installieren lassen, werden im Hintergrund aktualisiert. Die anderen werden angeboten.">
                <ToggleSwitch x:Name="AutoUpdateAppsSwitch" OnContent="" OffContent="" AutomationProperties.Name="Apps automatisch aktualisieren" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="UpdateAppsAutomatically" Margin="0" />
              <mat:MatSettingRow Title="Über Updates benachrichtigen" BorderThickness="0"
                                 Description="Eine kurze Mitteilung, wenn es für eine installierte App eine neue Version gibt.">
                <ToggleSwitch x:Name="NotifySwitch" OnContent="" OffContent="" AutomationProperties.Name="Über Updates benachrichtigen" />
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Cloud: ThixLauncher at MatCloud; its sign-in goes along with every app it installs ===== -->
          <TabItem x:Name="CloudTabItem" Header="Cloud">
            <StackPanel>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                         Text="Melde ThixLauncher einmal bei deiner MatCloud an: Jede App, die du danach hier installierst, ist gleich mit deinem Konto verbunden – ohne eigene Anmeldung. Ist die MatCloud nicht erreichbar, werden die Apps trotzdem installiert und melden sich später selbst an." />
              <controls:InfoBar x:Name="CloudMessage" />

              <!-- Not connected: sign in, in the browser (every account, also MatIdentity) or with user name and password -->
              <StackPanel x:Name="CloudLogin" MaxWidth="520" HorizontalAlignment="Left">
                <mat:MatFormField Label="Adresse der Cloud" controls:FormErrors.Field="ServerUrl" Hint="Die Adresse deiner MatCloud, z. B. https://cloud.example.com">
                  <TextBox x:Name="ServerUrlBox" Watermark="https://" />
                </mat:MatFormField>
                <mat:MatFormField Label="Name dieses Geräts" controls:FormErrors.Field="DeviceName" Hint="So erscheinen dieser Computer und seine Apps in der MatCloud unter „Geräte“.">
                  <TextBox x:Name="DeviceNameBox" />
                </mat:MatFormField>

                <!-- The first way: in the browser -->
                <StackPanel x:Name="BrowserSignIn" Margin="0,6,0,0">
                  <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                             Text="Die Anmeldung öffnet sich im Browser: Melde dich dort an – mit deinem Konto der MatCloud oder über MatIdentity – und bestätige den Code, den ThixLauncher dir zeigt." />
                  <controls:ActionBar>
                    <Button x:Name="BrowserConnectButton" Theme="{StaticResource MatButton.Primary}" Click="OnBrowserConnectClick">
                      <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                    </Button>
                    <Button x:Name="ShowPasswordSignInButton" Click="OnShowPasswordSignInClick">
                      <controls:IconLabel Icon="key" Text="Mit Benutzername und Passwort" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>

                <!-- Waiting for the browser: the code to compare -->
                <Border x:Name="BrowserCode" Theme="{StaticResource MatCard}" IsVisible="False" Margin="0,6,0,0">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Dein Code" Theme="{StaticResource MatText.Muted}" />
                    <SelectableTextBlock x:Name="BrowserCodeText" FontFamily="{DynamicResource Mat.Mono}" FontSize="{DynamicResource Mat.FontSize3xl}"
                                         FontWeight="SemiBold" LetterSpacing="3" Foreground="{DynamicResource Mat.AccentText}" AutomationProperties.Name="Code" />
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Bestätige den Code im Browser." />
                    <TextBlock Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap"
                               Text="Melde dich auf der Seite der MatCloud an und prüfe, dass dort derselbe Code steht. ThixLauncher verbindet sich, sobald du bestätigt hast." />
                    <controls:ActionBar Margin="0,4,0,0">
                      <Button x:Name="OpenLinkButton" Click="OnOpenLinkClick">
                        <controls:IconLabel Icon="external" Text="Seite erneut öffnen" />
                      </Button>
                      <Button x:Name="CancelLinkButton" Click="OnCancelLinkClick">
                        <controls:IconLabel Icon="x" Text="Abbrechen" />
                      </Button>
                    </controls:ActionBar>
                  </StackPanel>
                </Border>

                <!-- The second way: user name and password of a local account -->
                <StackPanel x:Name="PasswordSignIn" IsVisible="False" Margin="0,6,0,0">
                  <mat:MatFormField Label="Benutzername" controls:FormErrors.Field="UserName">
                    <TextBox x:Name="UserNameBox" />
                  </mat:MatFormField>
                  <mat:MatFormField Label="Passwort" controls:FormErrors.Field="Password" Hint="Wird nur für die Anmeldung gebraucht und nicht gespeichert.">
                    <TextBox x:Name="PasswordBox" PasswordChar="●" />
                  </mat:MatFormField>
                  <controls:ActionBar Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Theme="{StaticResource MatButton.Primary}" Click="OnConnectClick">
                      <controls:IconLabel Icon="login" Text="Anmelden" />
                    </Button>
                    <Button x:Name="ShowBrowserSignInButton" Click="OnShowBrowserSignInClick">
                      <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </StackPanel>

              <!-- Connected: the account, whether new apps go along, actions -->
              <StackPanel x:Name="CloudConnected" IsVisible="False">
                <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,14">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="Cloud" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <SelectableTextBlock Grid.Column="1" x:Name="CloudServerText" Margin="0,4" />
                    <TextBlock Grid.Row="1" Text="Konto" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CloudAccountText" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="Dieses Gerät" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CloudDeviceText" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="Status" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CloudStateText" Margin="0,4" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <controls:ActionBar Margin="0,0,0,10">
                  <Button Click="OnOpenCloudClick">
                    <controls:IconLabel Icon="external" Text="Im Browser öffnen" />
                  </Button>
                  <Button x:Name="DisconnectButton" Theme="{StaticResource MatButton.Danger}" controls:ActionBar.Separated="True" Click="OnDisconnectClick">
                    <controls:IconLabel Icon="logout" Text="Abmelden" />
                  </Button>
                </controls:ActionBar>
                <mat:MatSettingRow Title="Neue Apps gleich verbinden" BorderThickness="0"
                                   Description="Installiert ThixLauncher eine App, die die MatCloud kennt, meldet sie sich beim ersten Start mit diesem Konto an. Schon installierte Apps meldest du in der App selbst an.">
                  <ToggleSwitch x:Name="ConnectAppsSwitch" OnContent="" OffContent="" AutomationProperties.Name="Neue Apps gleich verbinden" />
                </mat:MatSettingRow>
              </StackPanel>
            </StackPanel>
          </TabItem>

          <!-- ===== Updates of ThixLauncher ===== -->
          <TabItem x:Name="UpdatesTabItem" Header="Updates">
            <StackPanel>
              <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="Installiert" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Column="1" x:Name="InstalledVersionText" Margin="0,4" />
                  <TextBlock Grid.Row="1" Text="Kanal" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChannelText" Margin="0,4" />
                  <TextBlock Grid.Row="2" Text="Zuletzt geprüft" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LastCheckText" Margin="0,4" />
                </Grid>
              </Border>
              <controls:InfoBar x:Name="UpdateMessage" />
              <ProgressBar x:Name="UpdateProgress" Theme="{StaticResource MatProgress}" IsVisible="False" Maximum="1" Margin="0,0,0,12" MaxWidth="560" HorizontalAlignment="Stretch" />
              <controls:ActionBar Margin="0,0,0,10">
                <Button x:Name="InstallUpdateButton" Theme="{StaticResource MatButton.Primary}" Click="OnInstallUpdateClick" IsVisible="False">
                  <controls:IconLabel Icon="download" Text="Update installieren" />
                </Button>
                <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick">
                  <controls:IconLabel Icon="refresh" Text="Nach Updates suchen" />
                </Button>
                <Button Click="OnReleasePageClick">
                  <controls:IconLabel Icon="external" Text="Versionen auf GitHub" />
                </Button>
              </controls:ActionBar>
              <mat:MatSettingRow Title="Automatisch nach Updates suchen" Description="Beim Start und alle 6 Stunden – für ThixLauncher (im eigenen Kanal) und für die Apps.">
                <ToggleSwitch x:Name="CheckUpdatesSwitch" OnContent="" OffContent="" AutomationProperties.Name="Automatisch nach Updates suchen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Updates automatisch installieren" BorderThickness="0"
                                 Description="Full-Auto-Update: neue Versionen von ThixLauncher werden ohne Rückfrage installiert, ThixLauncher startet danach neu im Hintergrund.">
                <ToggleSwitch x:Name="AutoInstallSwitch" OnContent="" OffContent="" AutomationProperties.Name="Updates automatisch installieren" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="InstallUpdatesAutomatically" Margin="0" />
            </StackPanel>
          </TabItem>

          <!-- ===== Advanced ===== -->
          <TabItem x:Name="AdvancedTabItem" Header="Erweitert">
            <StackPanel>
              <mat:MatSettingRow Title="Datenordner" x:Name="DataFolderRow">
                <Button Click="OnOpenDataFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Protokolle" x:Name="LogFolderRow" BorderThickness="0">
                <Button Click="OnOpenLogFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,16,0,0" TextWrapping="Wrap"
                         Text="Administratoren können ThixLauncher per Richtlinie einschränken (LockConfiguration, DisableAppChanges, DisableUpdates, DisableCloud) – unter Windows in HKLM\SOFTWARE\Policies\ThixLauncher, unter macOS per Konfigurationsprofil info.schmoldt.thixlauncher." />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
