<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the launcher: the business layer (catalog, versions, feeds against a fake GitHub, install / uninstall against a
    fake system, policies) and the UI, rendered headless with Avalonia + Skia (screenshots: THIXLAUNCHER_SCREENSHOTS=<folder>).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixLauncher\ThixLauncher.csproj" />
    <ProjectReference Include="..\..\src\ThixLauncher.Core\ThixLauncher.Core.csproj" />
  </ItemGroup>

</Project>
